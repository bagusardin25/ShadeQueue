# ShadeQueue backend configuration.
# Copy to .env and fill in real values. .env is gitignored; never commit secrets.

APP_ENV=local
# auto = live Phoenix+SVI in production, fixtures locally. live/fixture force one path.
SOURCE_MODE=auto
# Set true to re-fetch official Phoenix and CDC SVI snapshots on the next boot.
REFRESH_SOURCES=false

# Local Docker Compose PostGIS (see compose.yaml). Host port is 55432.
DATABASE_URL=postgresql+psycopg://shadequeue:shadequeue@127.0.0.1:55432/shadequeue

# --- FortyGuard provider -----------------------------------------------------
# Server-side only. Never expose to the browser, logs, URLs, or error responses.
FORTYGUARD_API_KEY=
FORTYGUARD_BASE_URL=https://api.fortyguard.com
# The published OpenAPI spec declares no securitySchemes, so the header name is
# configurable. Switch to "Authorization" with FORTYGUARD_API_KEY_PREFIX="Bearer "
# if the hackathon credentials turn out to be bearer tokens.
FORTYGUARD_API_KEY_HEADER=api-key
FORTYGUARD_API_KEY_PREFIX=

# Master switch. While false, every heat job is served by the deterministic
# fixture provider and no outbound provider request is made.
LIVE_PROVIDER_ENABLED=false

# --- Credit and abuse protection (plan section 14) ---------------------------
MAX_LIVE_JOBS_PER_DAY=25
MAX_LIVE_JOBS_PER_CLIENT_PER_DAY=5
MAX_AOI_AREA_KM2=25.0
ALLOWED_DATE_MIN=2024-06-01
ALLOWED_DATE_MAX=2026-08-31

# --- Provider timing ---------------------------------------------------------
PROVIDER_CONNECT_TIMEOUT_SECONDS=5.0
PROVIDER_READ_TIMEOUT_SECONDS=20.0
PROVIDER_POLL_INTERVAL_SECONDS=3
PROVIDER_JOB_TIMEOUT_SECONDS=600
# Simulated provider latency for fixture jobs, so the processing UI state is real.
FIXTURE_PROCESSING_SECONDS=3

# --- Frontend ----------------------------------------------------------------
# Public configuration, not a secret. Check the tile provider's usage and
# attribution terms before publishing a demo.
MAP_STYLE_URL=https://demotiles.maplibre.org/style.json
CORS_ALLOW_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
